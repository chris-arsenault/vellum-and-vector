{
  "name": "vellum-and-vector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:generation": "vitest run --config vitest.generation.config.ts",
    "inventory:society": "tsx scripts/society-inventory.ts",
    "test:browser": "sh -c 'if [ \"$BROWSER\" = firefox ] && [ \"$(uname)\" = Linux ]; then exec xvfb-run -a playwright test --headed \"$@\"; else exec playwright test \"$@\"; fi' --",
    "format": "prettier --write src *.ts *.json index.html"
  },
  "dependencies": {
    "@atlas/domain": "workspace:*",
    "@atlas/generation": "workspace:*",
    "@tanstack/react-query": "5.104.4",
    "antd": "5.29.3",
    "geostyler": "18.6.0",
    "geostyler-openlayers-parser": "5.8.0",
    "geostyler-style": "11.1.0",
    "ol": "10.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@ahara/standards": "github:chris-arsenault/ahara-standards#30e038a09b01c8f72e509e3fb1e7aa76003cda3a",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^3.0.0",
    "jiti": "2.7.0",
    "prettier": "^3.7.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
