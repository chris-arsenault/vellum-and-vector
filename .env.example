# CI/CD provisions credentials through Terraform and injects them via Komodo.
# Placeholders for local Compose configuration checks only.
ATLAS_DATABASE_PASSWORD=YOUR_LOCAL_ADMIN_PASSWORD
ATLAS_MAP_PASSWORD=YOUR_LOCAL_MAP_PASSWORD
ATLAS_MAP_READER_PASSWORD=YOUR_LOCAL_READER_PASSWORD
ATLAS_GENERATION_PASSWORD=YOUR_LOCAL_GENERATION_PASSWORD
# Optional LAN address and port overrides.
ATLAS_LAN_IP=192.168.66.3
ATLAS_PORT=4123
# Optional numerical memory budget shared by native jobs; otherwise use available host memory.
# ATLAS_GENERATION_MEMORY_BYTES=YOUR_NUMERICAL_MEMORY_BUDGET_IN_BYTES
