# Supply credentials through environment variables; use with-cred in Sulion.
ATLAS_DATABASE_PASSWORD=YOUR_LOCAL_PASSWORD
ATLAS_LAN_IP=192.168.66.3
ATLAS_PORT=4123
ATLAS_MAP_DATABASE_URL=postgresql://atlas_map_writer:YOUR_MAP_PASSWORD@192.168.66.3:5432/atlas
ATLAS_MAP_READER_URL=postgresql://atlas_map_reader:YOUR_READER_PASSWORD@192.168.66.3:5432/atlas
ATLAS_GENERATION_DATABASE_URL=postgresql://atlas_generation_writer:YOUR_GENERATION_PASSWORD@192.168.66.3:5432/atlas
ATLAS_DATA_DIRECTORY=/mnt/apps/apps/vellum-and-vector/data
ATLAS_SCRATCH_DIRECTORY=/mnt/apps/apps/vellum-and-vector/scratch
# Optional numerical memory budget shared by native jobs; otherwise use available host memory.
# ATLAS_GENERATION_MEMORY_BYTES=YOUR_NUMERICAL_MEMORY_BUDGET_IN_BYTES
ATLAS_UID=1000
ATLAS_GID=1000
ATLAS_TLS_CERTIFICATE=/path/to/lan-certificate.pem
ATLAS_TLS_PRIVATE_KEY=/path/to/lan-private-key.pem
